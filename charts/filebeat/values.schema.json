{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Filebeat + 10x chart values",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "tenx": {
      "type": "object",
      "additionalProperties": true,
      "required": ["variant"],
      "properties": {
        "variant": {
          "description": "10x distribution variant. Selects the published image. See https://doc.log10x.com/architecture/flavors",
          "type": "string",
          "enum": ["jit", "native"]
        }
      }
    }
  }
}
